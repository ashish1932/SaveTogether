# ========================================================
# SAVETOGETHER LOCAL / DEVELOPMENT ENVIRONMENT CONFIGURATION
# ========================================================

# APPLICATION
NODE_ENV=development
PORT=5000
APP_NAME=SaveTogether
API_PREFIX=api/v1

# DATABASE (DEV DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/savetogether_dev?schema=public

# AUTHENTICATION (DEV SECRETS)
JWT_SECRET=savetogether_dev_jwt_secret_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=savetogether_dev_jwt_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# REDIS (DEV INSTANCE)
REDIS_URL=redis://localhost:6379

# STORAGE (DEV BUCKET / MOCK)
AWS_ACCESS_KEY_ID=dev_mock_access_key
AWS_SECRET_ACCESS_KEY=dev_mock_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=savetogether-media-storage-dev

# FIREBASE / FCM (DEV PROJECT)
FCM_PROJECT_ID=savetogether-dev-fcm
FCM_CLIENT_EMAIL=dev_fcm_account@savetogether.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nDEV_MOCK_KEY\n-----END PRIVATE KEY-----"

# OTP / SMS PROVIDER (TEST SANDBOX)
OTP_PROVIDER=MSG91
OTP_API_URL=https://api.msg91.com/api/v5/otp
OTP_API_KEY=dev_mock_otp_api_key
OTP_SENDER_ID=SAVETG

# PAYMENT GATEWAY (SANDBOX / TEST MODE)
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_KEY_ID=rzp_test_mockkeyid
PAYMENT_KEY_SECRET=mock_razorpay_secret
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret

# SECURITY & CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000
LOG_LEVEL=debug
