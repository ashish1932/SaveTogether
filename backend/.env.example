# ==========================================
# SAVETOGETHER BACKEND ENVIRONMENT TEMPLATE
# ==========================================

# APPLICATION
NODE_ENV=development
PORT=5000
APP_NAME=SaveTogether
API_PREFIX=api/v1


# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/savetogether_db?schema=public


# AUTHENTICATION
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d


# REDIS
REDIS_URL=redis://localhost:6379


# STORAGE (AWS S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=savetogether-media-storage


# FIREBASE / FCM
FCM_PROJECT_ID=savetogether-app-fcm
FCM_CLIENT_EMAIL=firebase-adminsdk@savetogether.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."


# OTP / SMS PROVIDER
OTP_PROVIDER=MSG91
OTP_API_URL=https://api.msg91.com/api/v5/otp
OTP_API_KEY=your_otp_provider_key
OTP_SENDER_ID=SAVETG


# PAYMENT GATEWAY (RAZORPAY)
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_KEY_ID=your_razorpay_key_id
PAYMENT_KEY_SECRET=your_razorpay_key_secret
PAYMENT_WEBHOOK_SECRET=your_razorpay_webhook_secret


# CORS & SECURITY
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000


# LOGGING
LOG_LEVEL=info
