{
  "name": "bulk-service-booking-backend",
  "version": "1.0.0",
  "description": "Backend API Server for Bulk Service Booking & Demand Aggregation Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "ts-node test/e2e/full-system-journey.spec.ts",
    "test:critical": "ts-node test/critical/six-invariants.spec.ts",
    "test:integration": "ts-node test/integration/frontend-integration.spec.ts",
    "test:staging": "ts-node test/staging/staging-smoke.spec.ts",
    "test:production": "ts-node test/production/production-smoke.spec.ts",
    "test:monitoring": "ts-node test/monitoring/monitoring-metrics.spec.ts",
    "test:recovery": "ts-node test/recovery/disaster-recovery.spec.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
