# ========================================================
# SAVETOGETHER STAGING ENVIRONMENT CONFIGURATION
# ========================================================

# APPLICATION
NODE_ENV=staging
PORT=5000
APP_NAME=SaveTogether-Staging
API_PREFIX=api/v1

# DATABASE (STAGING DB - SEPARATE FROM PROD)
DATABASE_URL=postgresql://staging_user:staging_pass@staging-db.internal:5432/savetogether_staging?schema=public

# AUTHENTICATION (STAGING SECRETS)
JWT_SECRET=savetogether_staging_jwt_secret_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=savetogether_staging_jwt_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# REDIS (STAGING INSTANCE - SEPARATE FROM PROD)
REDIS_URL=redis://staging-redis.internal:6379

# STORAGE (STAGING BUCKET)
AWS_ACCESS_KEY_ID=staging_aws_access_key
AWS_SECRET_ACCESS_KEY=staging_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=savetogether-media-storage-staging

# FIREBASE / FCM (STAGING PROJECT)
FCM_PROJECT_ID=savetogether-staging-fcm
FCM_CLIENT_EMAIL=staging_fcm_account@savetogether.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSTAGING_KEY\n-----END PRIVATE KEY-----"

# OTP / SMS PROVIDER (STAGING TEST MODE)
OTP_PROVIDER=MSG91
OTP_API_URL=https://api.msg91.com/api/v5/otp
OTP_API_KEY=staging_otp_api_key
OTP_SENDER_ID=SAVETG

# PAYMENT GATEWAY (RAZORPAY SANDBOX)
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_KEY_ID=rzp_test_stagingkeyid
PAYMENT_KEY_SECRET=staging_razorpay_secret
PAYMENT_WEBHOOK_SECRET=staging_webhook_secret

# SECURITY & CORS
CORS_ORIGINS=https://admin-staging.savetogether.in,https://staging.savetogether.in
LOG_LEVEL=info
