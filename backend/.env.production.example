# ========================================================
# SAVETOGETHER LIVE PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# APPLICATION
NODE_ENV=production
PORT=5000
APP_NAME=SaveTogether
API_PREFIX=api/v1

# DATABASE (ISOLATED PRODUCTION PG INSTANCE)
DATABASE_URL=postgresql://prod_db_user:SUPER_STRONG_PROD_PASSWORD@prod-db-cluster.internal:5432/savetogether_production?schema=public&sslmode=require

# AUTHENTICATION (HIGH-ENTROPY PROD KEYS)
JWT_SECRET=PROD_MIN_64_CHAR_HIGH_ENTROPY_HMAC_SECRET_KEY_NEVER_SHARE
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=PROD_MIN_64_CHAR_HIGH_ENTROPY_REFRESH_SECRET_KEY_NEVER_SHARE
JWT_REFRESH_EXPIRES_IN=7d

# REDIS (ISOLATED PRODUCTION REDIS CLUSTER)
REDIS_URL=rediss://:SUPER_STRONG_REDIS_PASS@prod-redis-cluster.internal:6379

# STORAGE (ISOLATED PRODUCTION S3 BUCKET)
AWS_ACCESS_KEY_ID=AKIA_PROD_LIVE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=PROD_LIVE_SECRET_KEY_IAM_RESTRICTED
AWS_REGION=ap-south-1
AWS_S3_BUCKET=savetogether-media-storage-production

# FIREBASE / FCM (LIVE PROD PROJECT)
FCM_PROJECT_ID=savetogether-prod-fcm
FCM_CLIENT_EMAIL=prod_fcm_account@savetogether.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPROD_LIVE_KEY\n-----END PRIVATE KEY-----"

# OTP / SMS PROVIDER (LIVE GATEWAY)
OTP_PROVIDER=MSG91
OTP_API_URL=https://api.msg91.com/api/v5/otp
OTP_API_KEY=PROD_LIVE_MSG91_KEY
OTP_SENDER_ID=SAVETG

# PAYMENT GATEWAY (RAZORPAY LIVE MODE)
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_KEY_ID=rzp_live_PRODKEYID12345
PAYMENT_KEY_SECRET=PROD_LIVE_RAZORPAY_SECRET_KEY
PAYMENT_WEBHOOK_SECRET=PROD_LIVE_WEBHOOK_HMAC_SECRET

# SECURITY & CORS
CORS_ORIGINS=https://admin.savetogether.in,https://savetogether.in
LOG_LEVEL=warn
